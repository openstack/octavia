[Unit]
Description=Octavia active-active distributor agent
After=network-online.target openvswitch-switch.service cloud-init-final.service
Wants=network-online.target cloud-init-final.service
Requires=openvswitch-switch.service

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'if [ ! -s /etc/octavia/distributor-agent.conf ]; then mkdir -p /etc/octavia/certs /mnt/configdrive; for dev in /dev/sr0 /dev/hda /dev/hdc /dev/disk/by-label/config-2; do if [ -b "$dev" ] && mount -o ro "$dev" /mnt/configdrive 2>/dev/null; then if [ -s /mnt/configdrive/openstack/content/0002 ]; then cp /mnt/configdrive/openstack/content/0000 /etc/octavia/certs/client_ca.pem && cp /mnt/configdrive/openstack/content/0001 /etc/octavia/certs/server.pem && cp /mnt/configdrive/openstack/content/0002 /etc/octavia/distributor-agent.conf; umount /mnt/configdrive; exit 0; fi; umount /mnt/configdrive; fi; done; echo "config-drive not available" >&2; exit 1; fi'
ExecStart=/usr/local/bin/octavia-distributor-agent --config-file /etc/octavia/distributor-agent.conf
Restart=on-failure
RestartSec=5s
User=root

[Install]
WantedBy=multi-user.target
